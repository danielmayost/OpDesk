# OpDesk runtime config for PURE ASTERISK.
# Consumed by the opdesk container via env_file in compose.yml.

# --- OpDesk application database (the ONLY database used) ---
# Stores users/auth, settings, groups, monitor modes, notifications, and the CDR table.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=OpDesk
DB_PASSWORD=OpDeskPass123!
DB_OpDesk=OpDesk
DB_CDR=OpDesk

# --- Asterisk Manager Interface (the 'asterisk' service in this compose stack) ---
# Matches config/manager.conf -> [opdesk] secret = 12345678
AMI_HOST=192.168.15.100
AMI_PORT=9037
AMI_USERNAME=opdesk
AMI_SECRET=Da325400
# Dialplan context used for ExtensionState lookups (see config/extensions.conf).
AMI_CONTEXT=devices

# ------------------ local test----------------
#AMI_HOST=host.docker.internal
#AMI_PORT=5038
#AMI_USERNAME=opdesk
#AMI_SECRET=12345678
#AMI_CONTEXT=internal
#DB_HOST=mariadb
#DB_PORT=3306
#DB_USER=OpDesk
#DB_PASSWORD=OpDeskPass123!
#DB_OpDesk=OpDesk
#DB_CDR=OpDesk
#------------------------------------------------


# SIP channel driver for ChanSpy / interface normalisation.
# Set to 'chan_sip' if you use the legacy chan_sip module (then whisper/spy
# will originate to SIP/{supervisor}); leave at 'pjsip' for res_pjsip.
AMI_CHANNEL_TYPE=chan_sip

# --- Web server ---
# Plain HTTP on 8765. The dashboard + listen/whisper/barge do NOT need HTTPS
# (no browser microphone / getUserMedia is involved — supervision audio is delivered
# to the supervisor's own SIP phone via Asterisk ChanSpy).
PORT=8765
OPDESK_BIND_HOST=0.0.0.0
HTTPS_CERT=
HTTPS_KEY=
JWT_SECRET=change-me-to-a-long-random-string

# --- WebRTC softphone SIP server (pure-Asterisk single-host lab) ---
# Auto-derivation in server.py would produce wss://<host>/sip-ws, but we have no
# TLS and no /sip-ws proxy. Asterisk's plain WebSocket listener on 8088 is
# published by compose as 8088:8088/tcp, so point the softphone directly at it
# using ws:// (works because the UI is loaded over http://localhost, which the
# browser treats as a secure context for getUserMedia + WebSocket).
WEBRTC_PBX_SERVER=ws://localhost:8088/ws

# Same-origin frontend (served by uvicorn); "*" is fine for a LAN lab.
CORS_ALLOWED_ORIGINS=

# --- Initial admin login (seeded / reset on every startup while OPDESK_ADMIN_RESET=true) ---
OPDESK_ADMIN_USERNAME=admin
OPDESK_ADMIN_PASSWORD=opdesk1234
OPDESK_ADMIN_RESET=true

# Unused (recordings playback is part of the call-log feature).
ASTERISK_RECORDING_ROOT_DIR=/var/spool/asterisk/monitor/

# --- WebRTC softphone SIP secrets ---
# Comma-separated map of PJSIP extension -> SIP auth password (matches the
# `password=` field under [<ext>-auth] in pjsip.conf). The browser softphone
# uses this to register as your extension so listen/whisper/barge audio can
# be delivered to it.
OpDesk_WEBRTC_SECRETS=1003:pass1003,1004:pass1004,1005:pass1005,1006:pass1006